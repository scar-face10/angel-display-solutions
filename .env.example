# ============================================================
# Angels Display Solutions LLP — Environment Variables
# Copy this file to .env.local for local dev (never commit .env files).
# Set all these in: Netlify Dashboard → Site → Environment variables
# ============================================================

# Supabase (https://supabase.com → Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Resend (https://resend.com → API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Business email that receives enquiry notifications
BUSINESS_EMAIL=angelsdisplaysolutionsllp@gmail.com

# Sender email — MUST be from a Resend-verified domain
# For testing you can use: onboarding@resend.dev
SENDER_EMAIL=noreply@yourdomain.com

# Your Netlify site URL (no trailing slash)
ALLOWED_ORIGIN=https://your-site-name.netlify.app
